# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria

# Gemini (AI Studio); lido pelo workflow via $env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SCORE_HITL_MINIMO=50

# Airtable (IDs da base/tabela; o PAT fica na credencial do n8n)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_TABLE_CANDIDATES=Candidates

# Slack (token na credencial do n8n; canal via env)
SLACK_CHANNEL_RECRUTAMENTO=#rh-triagem

# Credenciais configuradas na UI do n8n (não coloque secrets reais neste arquivo):
# - Airtable Personal Access Token
# - Slack Bot Token / OAuth
# - Gmail OAuth2
# - Tally API Key (só se usar o nó Tally Trigger em vez de Webhook)
